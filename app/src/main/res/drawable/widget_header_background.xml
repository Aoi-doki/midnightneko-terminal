<?xml version="1.0" encoding="utf-8"?>
<!-- Widget title bar: surface fill, rounded at the top only, violet hairline underneath. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mayonaka_surface" />
            <corners
                android:topLeftRadius="18dp"
                android:topRightRadius="18dp" />
        </shape>
    </item>
    <item android:top="-1dp" android:left="-1dp" android:right="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/mayonaka_stroke" />
        </shape>
    </item>
</layer-list>
