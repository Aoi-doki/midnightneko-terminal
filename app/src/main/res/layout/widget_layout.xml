<?xml version="1.0" encoding="utf-8"?>
<!--
 The home-screen widget, merged from termux-widget and repainted in the midnight palette.

 RemoteViews only supports a fixed set of view types and attributes, so the rounding and the
 violet hairline come from background drawables rather than from a theme.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/top_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@drawable/widget_header_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="6dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:text="@string/title_widget"
            android:textColor="@color/mayonaka_foreground"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/refresh_button"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/ripple_mask"
            android:contentDescription="@string/action_refresh"
            android:padding="6dp"
            android:src="@drawable/ic_widget_refresh" />

    </LinearLayout>

    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_row"
        android:background="@android:color/transparent"
        android:divider="@color/mayonaka_muted"
        android:dividerHeight="1px"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:scrollbarThumbVertical="@color/mayonaka_muted" />

    <!-- Shown for an empty collection: rv.setEmptyView(R.id.widget_list, R.id.empty_view). -->
    <TextView
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_row"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/msg_refresh_widget_from_app"
        android:textColor="@color/mayonaka_foreground_dim"
        android:textSize="13sp" />

</RelativeLayout>
